{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "AQLEVON_CANDIDATE_ARTIFACT_MANIFEST_V1",
  "title": "AQLEVON Candidate Artifact Manifest V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_kind",
    "manifest_id",
    "artifact_type",
    "artifact_stage",
    "base",
    "tokenizer_sha256",
    "config_sha256",
    "training_shard_manifest_sha256",
    "training_run_receipt_sha256",
    "merge_recipe_sha256",
    "parameter_layout_sha256",
    "topology_class",
    "artifact_files",
    "artifact_file_tree_sha256",
    "adapter_state_sha256",
    "checkpoint_state_sha256",
    "parent_candidate_artifact_manifest_sha256",
    "environment_toolchain_manifest_sha256",
    "manifest_sha256"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "manifest_kind": {"const": "AQLEVON_CANDIDATE_ARTIFACT_MANIFEST_V1"},
    "manifest_id": {"type": "string", "pattern": "^aqlevon-candidate-artifact-v1:sha256:[0-9a-f]{64}$"},
    "artifact_type": {"enum": ["adapter", "full_checkpoint", "merge", "quantized_serving_artifact"]},
    "artifact_stage": {"enum": ["probe_only", "reproducible_gene", "promotion_candidate", "merge_candidate", "release_candidate"]},
    "base": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo", "revision", "base_manifest_sha256"],
      "properties": {
        "repo": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "base_manifest_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "tokenizer_sha256": {"$ref": "#/$defs/sha256"},
    "config_sha256": {"$ref": "#/$defs/sha256"},
    "training_shard_manifest_sha256": {"$ref": "#/$defs/nullableSha256"},
    "training_run_receipt_sha256": {"$ref": "#/$defs/nullableSha256"},
    "merge_recipe_sha256": {"$ref": "#/$defs/nullableSha256"},
    "parameter_layout_sha256": {"$ref": "#/$defs/sha256"},
    "topology_class": {"enum": ["FULL_HYBRID_TEXT", "ATTENTION_MLP_PARTIAL", "MLP_ONLY", "CUSTOM_EXPERIMENTAL"]},
    "artifact_files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "size", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "size": {"type": "integer", "minimum": 0},
          "sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "artifact_file_tree_sha256": {"$ref": "#/$defs/sha256"},
    "adapter_state_sha256": {"$ref": "#/$defs/nullableSha256"},
    "checkpoint_state_sha256": {"$ref": "#/$defs/nullableSha256"},
    "parent_candidate_artifact_manifest_sha256": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/sha256"}
    },
    "environment_toolchain_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "manifest_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullableSha256": {
      "oneOf": [
        {"$ref": "#/$defs/sha256"},
        {"type": "null"}
      ]
    }
  }
}