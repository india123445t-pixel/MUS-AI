# Supabase (public client configuration)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# MUS AI sovereign/self-hosted OpenAI-compatible endpoint (vLLM target)
# Use runtime_mode=self_hosted_only in MUS runtime settings to prohibit external inference fallback.
MUS_MODEL_URL=https://your-gpu-endpoint.example/v1/chat/completions
MUS_MODEL_HEALTH_URL=https://your-gpu-endpoint.example/health
MUS_MODEL_NAME=Qwen/Qwen3.8-27B-FP8
MUS_MODEL_KEY=

# Temporary teacher/fallback only — ignored when runtime_mode=self_hosted_only
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
MUS_AUTONOMOUS_MODEL=openrouter/free
