# Supabase (public client configuration)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# KITE sovereign/self-hosted OpenAI-compatible endpoint (vLLM target)
# Use runtime_mode=self_hosted_only in KITE runtime settings to prohibit external inference fallback.
# Public/API model identity is KITE-27B. The immutable upstream Qwen artifact remains pinned
# internally in the acquisition/runtime manifests for provenance and license compliance.
KITE_MODEL_URL=https://your-gpu-endpoint.example/v1/chat/completions
KITE_MODEL_HEALTH_URL=https://your-gpu-endpoint.example/health
KITE_MODEL_NAME=KITE-27B
KITE_MODEL_KEY=

# Temporary teacher/fallback only — ignored when runtime_mode=self_hosted_only
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
KITE_AUTONOMOUS_MODEL=openrouter/free
