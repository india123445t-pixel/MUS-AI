# Supabase (public client configuration)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# AQLEVON sovereign/self-hosted OpenAI-compatible endpoint (vLLM target)
# Use runtime_mode=self_hosted_only in AQLEVON runtime settings to prohibit external inference fallback.
# Public/API model identity is AQLEVON-27B. The immutable upstream Qwen artifact remains pinned
# internally in the acquisition/runtime manifests for provenance and license compliance.
AQLEVON_MODEL_URL=https://your-gpu-endpoint.example/v1/chat/completions
AQLEVON_MODEL_HEALTH_URL=https://your-gpu-endpoint.example/health
AQLEVON_MODEL_NAME=AQLEVON-27B
AQLEVON_MODEL_KEY=

# Temporary teacher/fallback only — ignored when runtime_mode=self_hosted_only
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
AQLEVON_AUTONOMOUS_MODEL=openrouter/free
